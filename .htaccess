Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.ht|(?:db|bootstrap|station_form|station_fields)\.php$|\.(sql|sqlite|db|bak|backup|old|log|ini|env|md)$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.ht|(?:db|bootstrap|station_form|station_fields)\.php$|\.(sql|sqlite|db|bak|backup|old|log|ini|env|md)$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RedirectMatch 404 /\.git(?:/|$)
